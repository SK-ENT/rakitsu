/artifacts/

# Superpowers SDD scratch (progress ledger, briefs) — local only
.superpowers/

# Launch-asset raw recordings — large binaries, never committed.
# The script + config + session JSONL receipts under this dir DO get
# committed; only the video files are excluded.
docs/internal/assets/launch/*.mov
docs/internal/assets/launch/*.mp4
